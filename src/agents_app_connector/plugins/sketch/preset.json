{
  "name": "sketch-translator",
  "labels": ["sketch"],
  "superleader_manageable": true,
  "spec": {
    "model": "claude-sonnet-5-5",
    "replicas": 1,
    "reuse_running_agent": true,
    "inactivity": {
      "close_seconds": 900
    },
    "peers": false,
    "wrapper": {
      "system_append": "@system_append.md",
      "permissions": {
        "deny": [
          "Bash",
          "Write",
          "Edit",
          "MultiEdit",
          "NotebookEdit",
          "WebFetch",
          "WebSearch",
          "Task",
          "Agent",
          "mcp__any-mcp__*",
          "mcp__ccw__*"
        ]
      },
      "mcp_servers": {
        "appconn": {
          "type": "http",
          "url": "@mcp_url",
          "headers": {
            "Authorization": "Bearer ${ORCH_AGENT_TOKEN}"
          }
        }
      }
    }
  }
}
